OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8000/v1
MODEL_NAME=
EXTRA_BODY=

# The model's context window, in tokens. Optional; defaults to 128000.
# There is no portable way to ask an OpenAI-compatible endpoint how large its
# window is, so set it yourself when the model is smaller than the default.
# Erring low only costs an extra summarization; erring high ends the session.
MAX_CONTEXT_TOKENS=
